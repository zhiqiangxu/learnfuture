<view class="container">
  <!-- 账户概览 -->
  <view class="card">
    <view class="balance-label">账户余额 (USDT)</view>
    <view class="balance-value">{{balance}}</view>
    <view class="flex-between mt-20">
      <view class="stat"><text class="text-muted text-sm">可用</text><text>{{available}}</text></view>
      <view class="stat"><text class="text-muted text-sm">冻结</text><text>{{frozen}}</text></view>
      <view class="stat"><text class="text-muted text-sm">总盈亏</text>
        <text class="{{parseFloat(totalPnl) >= 0 ? 'color-up' : 'color-down'}}">{{totalPnl}}</text>
      </view>
    </view>
  </view>

  <!-- 学习进度 -->
  <view class="card">
    <view class="flex-between">
      <text class="text-bold">学习进度</text>
      <text class="text-muted text-sm">{{progress.completed}}/{{progress.total}}</text>
    </view>
    <view class="progress-bar mt-20">
      <view class="progress-fill" style="width: {{progress.completed / progress.total * 100}}%"></view>
    </view>
    <view class="progress-pct">{{Math.round(progress.completed / progress.total * 100)}}%</view>
  </view>

  <!-- 操作 -->
  <view class="card menu-list">
    <view class="menu-item" bindtap="goLeaderboard">
      <text>排行榜</text><text class="text-muted">▸</text>
    </view>
    <view class="divider"></view>
    <view class="menu-item" bindtap="resetAccount">
      <text>重置账户</text><text class="text-muted">回到 10,000 USDT</text>
    </view>
  </view>

  <view class="disclaimer">
    <text class="text-muted text-sm">本平台为模拟交易学习工具，使用虚拟资金，不涉及真实交易</text>
  </view>
</view>
