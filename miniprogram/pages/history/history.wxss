.tabs { display: flex; margin-bottom: 20rpx; background: #1a1a2e; border-radius: 12rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx; color: #999; font-size: 26rpx; }
.tab.active { color: #00d4aa; border-bottom: 4rpx solid #00d4aa; }
.detail-row { display: flex; justify-content: space-between; padding: 6rpx 0; font-size: 26rpx; }
.pnl-summary-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
