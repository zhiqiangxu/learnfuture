.price-bar {
  display: flex; align-items: baseline; gap: 16rpx;
  margin-bottom: 20rpx;
}
.price-bar .price { font-size: 44rpx; font-weight: bold; }

.side-tabs { display: flex; gap: 0; margin-bottom: 20rpx; border-radius: 12rpx; overflow: hidden; }
.side-tab { flex: 1; text-align: center; padding: 20rpx; background: #2a2a4a; color: #999; font-size: 28rpx; }
.side-tab.active-long { background: #00d4aa; color: #fff; }
.side-tab.active-short { background: #ff4d6a; color: #fff; }

.type-tabs { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.type-tab { padding: 12rpx 32rpx; background: #2a2a4a; border-radius: 8rpx; color: #999; font-size: 26rpx; }
.type-tab.active { background: #3a3a5a; color: #fff; }

.input-group { margin-bottom: 20rpx; }
.input-label { font-size: 26rpx; color: #999; margin-bottom: 8rpx; display: block; }
.input-field {
  background: #0f0f23; border: 1rpx solid #2a2a4a; border-radius: 8rpx;
  padding: 16rpx 20rpx; color: #fff; font-size: 30rpx; width: 100%; box-sizing: border-box;
}

.lever-presets, .margin-presets {
  display: flex; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap;
}
.preset {
  padding: 8rpx 20rpx; background: #0f0f23; border-radius: 6rpx;
  color: #999; font-size: 24rpx;
}
.preset.active { background: #00d4aa; color: #fff; }

.tpsl-toggle { text-align: center; padding: 12rpx; }

.calc-detail { border: 1rpx solid #2a2a4a; }
.calc-title { display: flex; justify-content: space-between; align-items: center; }
.calc-row { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }

.submit-btn { width: 100%; margin-top: 30rpx; font-size: 32rpx; padding: 24rpx; border-radius: 12rpx; }
