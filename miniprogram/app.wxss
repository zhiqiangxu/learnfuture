/* 全局样式 - 暗色交易所风格 */
page {
  background-color: #0f0f23;
  color: #e0e0e0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
}

/* 涨跌色 */
.color-up { color: #00d4aa; }
.color-down { color: #ff4d6a; }
.bg-up { background-color: #00d4aa; }
.bg-down { background-color: #ff4d6a; }

/* 通用容器 */
.container {
  padding: 20rpx;
}

.card {
  background-color: #1a1a2e;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 按钮 */
.btn-long {
  background-color: #00d4aa;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-short {
  background-color: #ff4d6a;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-default {
  background-color: #2a2a4a;
  color: #e0e0e0;
  border: none;
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
}

/* 文字 */
.text-muted { color: #666; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 48rpx; }
.text-bold { font-weight: bold; }

/* 布局 */
.flex { display: flex; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }
.mt-20 { margin-top: 20rpx; }
.mb-20 { margin-bottom: 20rpx; }
.p-20 { padding: 20rpx; }

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #2a2a4a;
  margin: 16rpx 0;
}
